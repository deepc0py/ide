{
  "name": "ide-exthost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared VS Code extension host + LSP bridge for ide",
  "license": "Apache-2.0",
  "scripts": {
    "fetch": "bash scripts/fetch-vscode.sh",
    "build": "bash scripts/fetch-vscode.sh && node build.mjs",
    "license-audit": "node scripts/license-audit.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@vscode/iconv-lite-umd": "0.7.0",
    "@vscode/proxy-agent": "0.45.0",
    "@vscode/ripgrep": "1.15.9",
    "minimist": "1.2.8",
    "vscode-oniguruma": "1.7.0",
    "vscode-regexpp": "3.1.0",
    "vscode-textmate": "9.1.0",
    "yauzl": "3.1.3",
    "yazl": "2.5.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.2"
  }
}
